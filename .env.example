# PostgreSQL (Docker)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# Backend (NestJS)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001

# Frontend (Next.js) - used to call the backend API
# In production on Vercel, OMIT this var: frontend calls same-origin `/api/*`
# which Vercel rewrites to BACKEND_API_URL. Set it only when the backend is
# deployed on a different host AND called directly cross-origin.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Frontend (Next.js, server-only on Vercel) - backend origin that /api/* rewrites to
# e.g. https://my-portfolio-api.onrender.com
BACKEND_API_URL=""

FRONTEND_ORIGIN="http://localhost:3000"

# Seed admin user
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="jekejebdbjdjej"
ADMIN_NAME="Admin"
